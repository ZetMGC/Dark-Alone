config_version=5

[application]

config/name="Dark Alone"
config/description="Narrative first-person bar game. Anchor navigation prototype."
run/main_scene="res://scenes/main/main.tscn"
run/main_scene.integration_test="res://tests/playthrough_entry.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

export/convert_text_resources_to_binary=false

[gui]

theme/default_font_multichannel_signed_distance_field=true

[layer_names]

3d_physics/layer_1="Environment"
3d_physics/layer_2="Interactable"
3d_physics/layer_3="Player"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.04, 0.05, 1)

